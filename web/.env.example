# publishable key 按设计是公开的（要进浏览器 bundle）。
# **secret key（sb_secret_...）不许出现在任何 NEXT_PUBLIC_ 变量里**——
# next.config.ts 的构建期护栏会直接让 next build 失败。
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# 调试路由（/debug/rls）的构建期开关。1 = 开。
# **Vercel 生产环境不要配这一条**——不配即为关，那条路由不会被编译进产物。
NEXT_PUBLIC_ENABLE_DEBUG_ROUTES=1

# 模型 API key —— 对照臂 /onboarding/style-text 的 route handler 用它。
# **刻意不带 NEXT_PUBLIC_ 前缀**：带前缀的值会被内联进浏览器 bundle，
# 而这一条必须只留在服务端。构建期护栏只扫 NEXT_PUBLIC_*，正是为了给它留位置。
# 不配这一条时 /api/style/from-text 返回 503 并说明是服务端未配置，不静默失败。
ANTHROPIC_API_KEY=sk-ant-...

# 产品服务端（api/ · Render）的地址。上传页与讲解页在**浏览器里直连它**。
#
# 为什么直连而不走 Next 的 route handler 代理：**Vercel 的 serverless 请求体
# 上限是 4.5MB**，而上传上限是 50MB（测试集里最大的一份正好 4.5MB）。
# 代理一跳会把大课件挡在 Vercel 那一层，而那个失败与「文件太大」长得一样，
# 却发生在完全不同的地方。
#
# 连带：那个服务要配 `CORS_ALLOW_ORIGINS` 把这个站点的来源列进去。
# **它不配就是空清单（浏览器一律被挡），不是默认放开** —— 见 api/api/settings.py。
NEXT_PUBLIC_API_BASE_URL=https://<service>.onrender.com

# ---------------------------------------------------------------- 讲法矫正（2026-09-20）
#
# 用户在讲解里说一句「再短一点」「多举个例子」，由这个 key 调 Gemini Flash
# 把那句话映射到四条风格轴上（app/api/style/from-text/route.ts）。
#
# ⚠️ **不带 NEXT_PUBLIC_ 前缀**，这是硬要求：带了就会被内联进浏览器 bundle，
# 拿到页面的人都能烧这个额度。构建期护栏只扫 NEXT_PUBLIC_*，正是为了让
# 服务端密钥有地方放。
#
# 放两个地方：
#   · 本地：web/.env.local
#   · 线上：Vercel 项目的 Environment Variables（这条路由跑在 Vercel 上，
#     不在 Render —— Render 上那个服务只管讲解与上传）
#
# 免费额度约 10 次/分钟，够个人测试版用；超了这条路由返回 429 并说清是额度。
GEMINI_API_KEY=

# 可选：换一个模型 id。默认 **gemini-flash-latest**（别名，不是带版本号的 id）。
#
# ⚠️ 默认值曾经写成带版本号的 id，2026-09-21 连错两次：
# gemini-2.5-flash → 404，换 gemini-2.0-flash → 404，
# 而那把 key 真正能用的是 2.5 / 3.x / 3.5–3.8 那一代。
# **根因不是挑错型号，是拿训练数据里的版本号当事实。** 所以现在默认用别名。
#
# 想更省的话可以填 gemini-flash-lite-latest（免费额度更高，任务只是四条轴的分类）。
GEMINI_MODEL=

# 可选：API 版本，默认 v1beta。
# 撞到「模型明明在 ListModels 里却调不通 404」时，把它设成 v1 再试——
# 那说明该模型的 generateContent 已经不在 v1beta 上了。
GEMINI_API_VERSION=
